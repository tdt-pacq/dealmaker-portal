# ─── Portal Login ────────────────────────────────────────────────────────────
TEAM_USERNAME=your_username
TEAM_PASSWORD=your_password

# ─── Anthropic (AI generation) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database (Railway: set DB_PATH=/data/pacq_deals.db and mount volume at /data) ──
# Leave blank for local dev — defaults to server/pacq_deals.db
DB_PATH=
