# ─── Portal Login ────────────────────────────────────────────────────────────
TEAM_USERNAME=your_username
TEAM_PASSWORD=your_password

# ─── Anthropic (AI generation) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database (Render: set DB_PATH=/data/pacq_deals.db and mount volume at /data) ──
# Leave blank for local dev — defaults to server/pacq_deals.db
DB_PATH=

# ─── Resources nav (optional — set at build time; blank = Coming Soon in sidebar) ─
# VITE_RESOURCE_DEAL_SOP_URL=https://docs.google.com/document/d/.../edit
# VITE_RESOURCE_MARKETING_SOP_URL=https://docs.google.com/document/d/.../edit
# VITE_RESOURCE_TRAINING_URL=https://docs.google.com/document/d/.../edit
